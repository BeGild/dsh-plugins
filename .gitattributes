# Normalise line endings so CI on Linux sees the same bytes you commit.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.tgz binary
*.tar.gz binary
*.zip binary
*.pdf binary
*.woff2 binary
