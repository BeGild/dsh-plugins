{
  "name": "dsh-apply-patch",
  "version": "0.1.0",
  "description": "Apply a structured multi-file patch (add/update/delete/move) to DeepSeek Harness in one atomic tool call: the whole patch is planned before anything is written, so a bad hunk changes nothing.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/dsh-plugins.git",
    "directory": "plugins/dsh-apply-patch"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "apply-patch",
    "patch",
    "diff",
    "multi-file",
    "atomic-edit"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/patch.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
