{
  "name": "dsh-ekko-ui",
  "version": "0.2.2",
  "description": "Renders a DSH conversation's agent output the way WorkBuddy does: a turn collapses to one line naming what it did, and each tool call is a borderless status line.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeGild/dsh-plugins.git",
    "directory": "plugins/dsh-ekko-ui"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    },
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./fold": "./lib/fold.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/fold.test.mjs && node test/client.test.mjs",
    "build:hl": "esbuild highlight-entry.mjs --bundle --format=iife --global-name=wbhl --outfile=lib/highlight.bundle.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
