{
  "name": "dsh-skill-menu",
  "version": "0.3.2",
  "description": "Owns the '/' candidate menu view: skill candidates grouped under package sections with marketplace icons, on top of the untouched stock trigger framework.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BeGild/dsh-plugins.git",
    "directory": "plugins/dsh-skill-menu"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skill",
    "menu",
    "ux"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "entry": "./client",
      "inject": ["@deepseek-ai/dsh-client-ui-primitives"]
    },
    "engines": {
      "dsh": ">=0.1.5-rc.2"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/menu.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
